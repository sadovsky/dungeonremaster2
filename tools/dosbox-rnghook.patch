--- a/src/cpu/core_normal.cpp
+++ b/src/cpu/core_normal.cpp
@@ -136,9 +136,73 @@
 
 #define EALookupTable (core.ea_table)
 
+/* dm2 research hook: log every executed draw of Dungeon Master II's random
+ * number generator, i.e. "imul eax,[state],0xBB40E62D", with the game tick
+ * and four stack words, to the file named by DM2_RNGLOG. */
+#include <cstdio>
+#include <cstdlib>
+static FILE * dm2_log = 0;
+static bool dm2_init = false;
+static INLINE void dm2_rng_hook(void) {
+	if (!dm2_init) {
+		dm2_init = true;
+		const char * p = getenv("DM2_RNGLOG");
+		if (p) dm2_log = fopen(p, "w");
+	}
+	if (!dm2_log) return;
+	PhysPt ip = core.cseip;
+	/* Once the code and data offsets are known (from the first random draw),
+	 * also log every entry to the frame-timing routine 0x3023F, draw or not:
+	 * "F tick creature seq_off status(+0x0A) armed(+0x21)". */
+	static Bit32u dm2_code_delta = 0, dm2_data_delta = 0;
+	if (dm2_code_delta && ip == 0x3023F + dm2_code_delta) {
+		Bit32u d = dm2_data_delta;
+		Bit32u cr = LoadMw(0x7F548 + d);
+		Bit32u rec = LoadMd(0x7F54A + d), sl = LoadMd(0x7F552 + d), sq = LoadMd(0x7F55A + d);
+		Bit32u status = rec ? LoadMw(SegBase(ds) + rec + 10) : 0xffff;
+		Bit32u armed = sl ? LoadMb(SegBase(ds) + sl + 0x21) : 0xff;
+		Bit32u off = sq ? LoadMw(SegBase(ds) + sq + 2) : 0xffff;
+		fprintf(dm2_log, "F %u %x %x %x %x\n", LoadMd(0x7F22C + d), cr, off, status, armed);
+		return;
+	}
+	if (LoadMb(ip) != 0x69 || LoadMb(ip + 1) != 0x05) return;
+	if (LoadMd(ip + 6) != 0xBB40E62DU) return;
+	Bit32u data_delta = LoadMd(ip + 2) - 0x70518;
+	if (!dm2_code_delta) {
+		static const Bit32u sites[3] = { 0x1C6A1, 0x1C6DC, 0x1C6F6 };
+		for (int i = 0; i < 3; i++)
+			if (((ip - sites[i]) & 0xfff) == 0) dm2_code_delta = ip - sites[i];
+		dm2_data_delta = data_delta;
+	}
+	Bit32u tick = LoadMd(0x7F22C + data_delta);
+	PhysPt sp = SegBase(ss) + reg_esp;
+	/* 0x7F548: the thing reference of the creature whose AI context is loaded. */
+	Bit32u creature = LoadMw(0x7F548 + data_delta);
+	/* 0x7F552: pointer to that creature's active slot (0x22 bytes); log its
+	 * program (+0x12), step (+0x13), queued action (+0x17) and action (+0x1A). */
+	Bit32u slot = LoadMd(0x7F552 + data_delta);
+	Bit32u prog = 0xffff, step = 0xffff, queued = 0xffff, action = 0xffff;
+	if (slot) {
+		PhysPt s = SegBase(ds) + slot;
+		prog = LoadMb(s + 0x12); step = LoadMb(s + 0x13);
+		queued = LoadMb(s + 0x17); action = LoadMb(s + 0x1a);
+	}
+	/* 0x7F55A: pointer to the loaded creature's (sequence start, offset) words. */
+	Bit32u seqp = LoadMd(0x7F55A + data_delta);
+	Bit32u seq_start = 0xffff, seq_off = 0xffff;
+	if (seqp) {
+		PhysPt q = SegBase(ds) + seqp;
+		seq_start = LoadMw(q); seq_off = LoadMw(q + 2);
+	}
+	fprintf(dm2_log, "%u %x %x %x %x %x %x %x %x %x %x %x %x %x\n", tick, ip, data_delta,
+		LoadMd(sp), LoadMd(sp + 4), LoadMd(sp + 8), LoadMd(sp + 12), creature,
+		prog, step, queued, action, seq_start, seq_off);
+}
